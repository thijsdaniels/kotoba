 "strings": [
  {
   "source": "scripts/Route1.asm",
   "label": "Route1Youngster1Text.MartSampleText",
   "line": 30,
   "text": "わたし　フレンドリィ　ショップの\nてんいん　です\n\nべんりな　どうぐや　ですから\nトキワ　シティで\nぜひ　よって　くださいね！\n\nそうだ！\nみほんを　さしあげましょう\n……　どうぞ！"
  },
  {
   "source": "scripts/Route1.asm",
   "label": "Route1Youngster1Text.GotPotionText",
   "line": 43,
   "text": "{player}は\n「"
  },
  {
   "source": "scripts/Route1.asm",
   "label": "Route1Youngster1Text.GotPotionText",
   "line": 46,
   "text": "」を　もらった！",
   "continuation": true
  },
  {
   "source": "scripts/Route1.asm",
   "label": "Route1Youngster1Text.AlsoGotPokeballsText",
   "line": 51,
   "text": "ポケモンを　つかまえる\nモンスターボール　かう　ときも\nショップへ　いらして　ください！"
  },
  {
   "source": "scripts/Route1.asm",
   "label": "Route1Youngster1Text.NoRoomText",
   "line": 57,
   "text": "にもつが　いっぱいだ！"
  },
  {
   "source": "scripts/Route1.asm",
   "label": "Route1Youngster2Text",
   "line": 61,
   "text": "みちに　だんさが　あるだろ！\n\nとび　おりるのは\nちょっと　こわいけど……\n\nマサラ　タウンに　かえる　ときは\nはやく　かえれて　いいよ"
  },
  {
   "source": "scripts/Route1.asm",
   "label": "Route1SignText",
   "line": 71,
   "text": "ここは　１ばん　どうろ\nマサラ　タウン　……　トキワ　シティ"
  }
 ],
