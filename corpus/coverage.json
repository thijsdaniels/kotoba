  {
   "source": "engine/events/give_pokemon.asm",
   "label": "SentToBoxText",
   "line": 70,
   "text": "ポケモンを　もちきれないので\nパソコンの　ボックス{name}に{boxmonnicks}を　てんそうした！"
  },
  {
   "source": "engine/events/give_pokemon.asm",
   "label": "BoxIsFullText",
   "line": 80,
   "text": "ポケモンを　もちきれません！\n\nボックスも　いっぱいで\nてんそうできません！\n\nポケモンセンターなどで\nボックスを　かえてきて　ください"
  },
  {
   "source": "engine/events/pokedex_rating.asm",
   "label": "DexRatingText_Own10To19",
   "line": 92,
   "text": "どうにか　ちょうしが　でてきたな！\nじょしゅに　フラッシュを\nもたせたぞ！　もらって　くれい！"
  },
  {
   "source": "engine/events/pokedex_rating.asm",
   "label": "DexRatingText_Own20To29",
   "line": 98,
   "text": "ポケモンずかんに　しては　まだ\nボリュームが　たりん！　いろいろな\nしゅるいの　ポケモンを　とるのじゃ！"
  },
  {
   "source": "engine/events/pokedex_rating.asm",
   "label": "DexRatingText_Own30To39",
   "line": 104,
   "text": "ふむ……　がんばってるな！\nじょしゅに　ダウジングマシンを\nもたせたぞ！　もらって　くれい！"
  },
  {
   "source": "engine/events/pokedex_rating.asm",
   "label": "DexRatingText_Own40To49",
   "line": 110,
   "text": "いい　できばえ　じゃないか！\nじょしゅに　がくしゅうそうちを\nもたせたぞ！　もらって　くれい！"
  },
  {
   "source": "engine/events/pokedex_rating.asm",
   "label": "DexRatingText_Own50To59",
   "line": 116,
   "text": "ついに　５０しゅるいを　こえたか！\n……　この　ちょうし　じゃ！"
  },
  {
   "source": "engine/events/pokedex_rating.asm",
   "label": "DexRatingText_Own60To69",
   "line": 121,
   "text": "ほっほう！　……　こりゃ　いい\nポケモンずかんに　なって　きとる！"
  },
  {
   "source": "engine/events/pokedex_rating.asm",
   "label": "DexRatingText_Own70To79",
   "line": 126,
   "text": "ぜっこうちょう！　うみで　ポケモン\nつれば　もっと　あつまり　そうじゃ！"
  },
  {
   "source": "engine/events/pokedex_rating.asm",
   "label": "DexRatingText_Own80To89",
   "line": 131,
   "text": "ワンダフル！　もしかして　きみは\nものを　あつめるの　すきなのか……？"
  },
  {
   "source": "engine/events/pokedex_rating.asm",
   "label": "DexRatingText_Own90To99",
   "line": 136,
   "text": "いやはや……　こりゃ　すごい！\nあつめるのは　たいへん　だったろ！"
  },
  {
   "source": "engine/events/pokedex_rating.asm",
   "label": "DexRatingText_Own100To109",
   "line": 141,
   "text": "とうとう　１００しゅるい　こえたか！\n……　しんじられない　うでまえじゃ！"
  },
  {
   "source": "engine/events/pokedex_rating.asm",
   "label": "DexRatingText_Own110To119",
   "line": 146,
   "text": "ポケモンの　しんか　けいたいも\nはいって　きとる……　すばらしい！"
  },
  {
   "source": "engine/events/pokedex_rating.asm",
   "label": "DexRatingText_Own120To129",
   "line": 151,
   "text": "エクセレント！　ともだちと　こうかん\nすると　もっと　あつまる　かもしれん"
  },
  {
   "source": "engine/events/pokedex_rating.asm",
   "label": "DexRatingText_Own130To139",
   "line": 156,
   "text": "ここまで　ずかんが　できたら\nもはや　プロフェッショナル　じゃ！"
  },
  {
   "source": "engine/events/pokedex_rating.asm",
   "label": "DexRatingText_Own140To149",
   "line": 161,
   "text": "わしゃ　もう　いうことは　ない！\nきみが　ポケモンはかせ　じゃ！"
  },
  {
   "source": "engine/events/pokedex_rating.asm",
   "label": "DexRatingText_Own150To151",
   "line": 166,
   "text": "ついに　パーフェクトな　ずかんの\nかんせいじゃ！　……　おめでとう！"
  },
